{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "HotChocolate": "Warning",
      "Autheris": "Warning",
      "GqlGateway": "Warning"
    }
  },

  "Gateway": {
    "Hosting": {
      "MaxConcurrentConnections": 50000,
      "MaxConcurrentUpgradedConnections": 10000,
      "MaxRequestBodySizeBytes": 10485760
    },

    "HighAvailability": {
      "DrainDelaySeconds": 1,
      "QueryTimeoutSeconds": 15,
      "ShutdownTimeoutSeconds": 25,
      "TerminationGracePeriodSeconds": 45
    },

    "Authentication": {
      "Domain": "CORP.LOCAL",
      "ServicePrincipalName": "HTTP/autheris.corp.local",
      "RequireKerberosOnly": false,
      "GroupCacheTtlMinutes": 60,
      "EnableTestAuthHandler": true
    },

    "GovernanceDb": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=:memory:;Mode=Memory;Cache=Shared",
      "CommandTimeoutSeconds": 15,
      "EnableOutboxProcessor": false,
      "SeedDemoData": true
    },

    "Insecure": {
      "danger_bypass_consent_checks": true
    },

    "DataSources": {
      "Connections": {
        "chinook": {
          "ConnectionString": "Host=postgres;Port=5432;Database=postgres;Username=postgres;Password=REDACTED_HISTORICAL_BENCHMARK_SECRET;Pooling=true;Maximum Pool Size=100;Minimum Pool Size=10",
          "CommandTimeoutSeconds": 15,
          "Dialect": "PostgreSql"
        },
        "finance": {
          "ConnectionString": "Host=postgres;Port=5432;Database=postgres;Username=postgres;Password=REDACTED_HISTORICAL_BENCHMARK_SECRET;Pooling=true;Maximum Pool Size=100;Minimum Pool Size=10",
          "CommandTimeoutSeconds": 15,
          "Dialect": "PostgreSql"
        }
      }
    },

    "SingleQueryPushdown": {
      "Enabled": true,
      "MaxSubqueryDepth": 5
    },

    "Caching": {
      "L1MemoryCache": {
        "SizeLimitMb": 2048,
        "DefaultTtlMinutes": 60,
        "SensitiveTableTtlSeconds": 600
      },
      "EpochValidation": {
        "FailClosedOnSensitiveTables": false,
        "DegradedMaxStalenessSeconds": 300,
        "PipelinedMGetEnabled": true
      }
    },

    "RateLimiting": {
      "PreAuthIpRateLimit": {
        "PermitLimit": 100000,
        "WindowSeconds": 60,
        "QueueLimit": 10000
      },
      "PostAuthSidRateLimit": {
        "TokenBucketCapacity": 100000,
        "TokensPerSecond": 10000,
        "MaxCostPerMinute": 1000000
      }
    },

    "GraphQL": {
      "MaxAllowedExecutionDepth": 25,
      "MaxAllowedComplexity": 10000,
      "EnableIntrospection": true,
      "PersistedQueriesOnly": false,
      "EnableBananaCakePop": false,
      "MaxResponseRows": 50000,
      "MaxResponseBytes": 52428800
    },

    "DataMasking": {
      "HmacKeyId": "bench-key-2026",
      "HmacSecretKeyVaultRef": "BENCH-HMAC-SECRET-KEY",
      "MaskingCacheTtlHours": 24
    },

    "Audit": {
      "TierAEnabled": false,
      "TierBAggregationWindowSeconds": 300,
      "AuditLogRetentionDays": 1,
      "VerifyHashChainIntervalHours": 24,
      "ElasticsearchSinkUrl": ""
    }
  }
}
