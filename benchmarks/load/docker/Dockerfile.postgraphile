FROM node:26.11.1-alpine@sha256:143494b1da2945f061539253adc65e4f1569ddf07da2d384c022c791a9d90a4a
WORKDIR /app

COPY benchmarks/load/configs/postgraphile/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/postgraphile/index.js ./

ENV PORT=5001 \
    NODE_ENV=production

EXPOSE 5001
CMD ["node", "index.js"]
