FROM node:26.12.0-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5
WORKDIR /app

COPY benchmarks/load/configs/postgraphile/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/postgraphile/index.js ./

ENV PORT=5001 \
    NODE_ENV=production

EXPOSE 5001
CMD ["node", "index.js"]
