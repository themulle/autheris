FROM node:26.12.1-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797
WORKDIR /app

COPY benchmarks/load/configs/postgraphile/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/postgraphile/index.js ./

ENV PORT=5001 \
    NODE_ENV=production

EXPOSE 5001
CMD ["node", "index.js"]
