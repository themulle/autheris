FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
WORKDIR /app

COPY benchmarks/load/configs/apollo-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/apollo-server/index.js ./

ENV PORT=4000 \
    NODE_ENV=production

EXPOSE 4000
CMD ["node", "index.js"]
