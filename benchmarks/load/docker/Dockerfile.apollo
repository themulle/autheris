FROM node:26.13.0-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94
WORKDIR /app

COPY benchmarks/load/configs/apollo-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/apollo-server/index.js ./

ENV PORT=4000 \
    NODE_ENV=production

EXPOSE 4000
CMD ["node", "index.js"]
