FROM node:26.12.0-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5
WORKDIR /app

COPY benchmarks/load/configs/apollo-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/apollo-server/index.js ./

ENV PORT=4000 \
    NODE_ENV=production

EXPOSE 4000
CMD ["node", "index.js"]
