FROM node:26.13.0-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216
WORKDIR /app

COPY benchmarks/load/configs/apollo-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/apollo-server/index.js ./

ENV PORT=4000 \
    NODE_ENV=production

EXPOSE 4000
CMD ["node", "index.js"]
