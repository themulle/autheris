FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
WORKDIR /app

COPY benchmarks/load/configs/apollo-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY benchmarks/load/configs/apollo-server/index.js ./

ENV PORT=4000 \
    NODE_ENV=production

EXPOSE 4000
CMD ["node", "index.js"]
