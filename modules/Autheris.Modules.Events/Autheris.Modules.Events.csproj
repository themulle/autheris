    </ProjectReference>
    <ProjectReference Include="..\..\src\Autheris.Domain\Autheris.Domain.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Autheris.Application\Autheris.Application.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime;native</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Autheris.Modules.Events.Tests" />
    <InternalsVisibleTo Include="Autheris.Tests.Unit" />
