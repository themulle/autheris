<Project Sdk="Microsoft.NET.Sdk">

  <!-- REQ-SIMTEST P2: standalone loopback API host for Schemathesis. Not part of Autheris.sln, never published (SEC-SIM-03/21).
       This project never enables the test-auth build switch: only the build command line of the sim-api-fuzz job does (see
       simulation-nightly.yml). Without it Autheris.Api has no test-auth handler and this host refuses to start. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Autheris.Api\Autheris.Api.csproj" />
  </ItemGroup>

</Project>
