<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <DefineConstants>$(DefineConstants);AUTHERIS_INTEGRATION_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.Oracle" Version="4.16.0" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Autheris.Api\Autheris.Api.csproj" />
    <ProjectReference Include="..\Autheris.Tests.Common\Autheris.Tests.Common.csproj" />
    <Compile Include="..\Autheris.Tests.Unit\AccessProfiles\AccessProfileRepositoryContractBase.cs" Link="AccessProfileRepositoryContractBase.cs" />
    <Compile Include="..\Autheris.Tests.Unit\ConsentRequests\ConsentDecisionStatusGuardContractBase.cs" Link="ConsentDecisionStatusGuardContractBase.cs" />
    <Compile Include="..\Autheris.Tests.Unit\Governance\RowFilterEvaluationRepositoryContractTestsBase.cs" Link="RowFilterEvaluationRepositoryContractTestsBase.cs" />
    <Compile Include="..\Autheris.Tests.Unit\Governance\CatalogSettingsRepositoryContractTestsBase.cs" Link="CatalogSettingsRepositoryContractTestsBase.cs" />
    <Compile Include="..\Autheris.Tests.Unit\Governance\RelationRepositoryContractTestsBase.cs" Link="RelationRepositoryContractTestsBase.cs" />
    <Compile Include="..\Autheris.Tests.Unit\Governance\ConsentDescriptionRepositoryContractBase.cs" Link="ConsentDescriptionRepositoryContractBase.cs" />
    <Compile Include="..\Autheris.Tests.Unit\TestDoubles\RuntimeSkip.cs" Link="TestDoubles\RuntimeSkip.cs" />
    <ProjectReference Include="..\..\src\Autheris.Extensions\Autheris.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Demo-catalog SQL tables have no database behind them; workflow tests read deterministic synthetic rows. -->
    <Compile Include="..\Autheris.Tests.Unit\TestDoubles\SyntheticSqlDataSourceExecutor.cs" Link="TestDoubles\SyntheticSqlDataSourceExecutor.cs" />
    <Compile Include="..\Autheris.Tests.Unit\Webhooks\WebhookOutboxContractTests.cs" Link="Webhooks\WebhookOutboxContractTests.cs" />
    <Compile Include="..\Autheris.Tests.Unit\Persistence\CloudEventSubscriptionStoreContractTests.cs" Link="Persistence\CloudEventSubscriptionStoreContractTests.cs" />
    <!-- REQ-CDC-99: stream store, crypto and codec test doubles of the producer tests (the real ones are built by I1-A/I1-C). -->
    <Compile Include="..\Autheris.Tests.Unit\Cdc\CdcStreamTestDoubles.cs" Link="Cdc\CdcStreamTestDoubles.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Spark\runner.py" CopyToOutputDirectory="PreserveNewest" LinkBase="Spark" />
    <None Include="Spark\Dockerfile" CopyToOutputDirectory="PreserveNewest" LinkBase="Spark" />
    <None Include="Spark\fetch-delta.py" CopyToOutputDirectory="PreserveNewest" LinkBase="Spark" />
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>