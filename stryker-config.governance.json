{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "configuration": "Release",
    "test-case-filter": "FullyQualifiedName~FunctionalRightMapper|FullyQualifiedName~ScopedAccessPolicy|FullyQualifiedName~IdentityDeprovisioningService|FullyQualifiedName~IdentityRealmRegistry|FullyQualifiedName~RebacTableGate",
    "mutate": [
      "**/Governance/Rights/FunctionalRightMapper.cs",
      "**/Governance/Rights/Validators/FunctionalRightMappingValidator.cs",
      "**/Governance/Policies/ScopedAccessPolicyEngine.cs",
      "**/Identity/IdentityRealmRegistry.cs",
      "**/Identity/Services/IdentityDeprovisioningService.cs",
      "**/Policy/RebacTableGate.cs"
    ],
    "thresholds": {
      "high": 85,
      "low": 75,
      "break": 70
    },
    "concurrency": 8,
    "reporters": [
      "progress",
      "cleartext",
      "json",
      "html"
    ],
    "project": "Autheris.Application.csproj"
  }
}
