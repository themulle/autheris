# Copy to .env (untracked) and replace every CHANGE_ME, or run ./scripts/generate-env.sh
# to create .env with random values. Never commit .env.
# BENCHMARK-ONLY stack: do not reuse these values anywhere else.

GQL_PG_PASSWORD=CHANGE_ME
# SQL Server requires a complex password (upper/lower/digit/symbol, >= 8 chars)
MSSQL_SA_PASSWORD=CHANGE_ME_Aa1!
MSSQL_CRM_PASSWORD=CHANGE_ME_CRM_Aa1!
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
GATEWAY_HMAC_SECRET=CHANGE_ME
FORWARD_AUTH_SHARED_SECRET=CHANGE_ME

# Optional: interface for published ports (default 127.0.0.1)
# BIND_ADDR=127.0.0.1
