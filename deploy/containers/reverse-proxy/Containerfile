# ==============================================================================
# Containerfile for reverse-proxy (Nginx ForwardAuth Proxy)
# ==============================================================================

FROM docker.io/library/nginx:alpine

RUN apk add --no-cache wget curl

COPY containers/reverse-proxy/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

HEALTHCHECK --interval=3s --timeout=3s --start-period=3s --retries=10 \
    CMD wget -q -O- http://127.0.0.1:8080/health/live || exit 1

CMD ["nginx", "-g", "daemon off;"]
