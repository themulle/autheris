# ==============================================================================
# Containerfile for lakehouse-seed
# Initializes the MinIO bucket and seeds Apache Iceberg metadata and data chunks
# ==============================================================================

FROM python:3.12-alpine@sha256:1b668429b3511ab407d8e00648891631b0b1a4d7e15e3ca70f38ab5b91ad4ab4

WORKDIR /app

RUN pip install --no-cache-dir boto3==1.43.108

COPY containers/lakehouse-seed/seed_lakehouse.py .
COPY containers/lakehouse-seed/sample_iceberg/ ./sample_iceberg/

RUN addgroup -g 10001 appgroup && adduser -u 10001 -G appgroup -s /bin/sh -D appuser && \
    chown -R appuser:appgroup /app

USER 10001:10001

HEALTHCHECK --interval=2s --timeout=2s --start-period=1s --retries=20 \
    CMD test -f /tmp/.lakehouse_seed_complete || exit 1

CMD ["sh", "-c", "python3 seed_lakehouse.py && tail -f /dev/null"]
