# ==============================================================================
# Containerfile for mock-extensions
# Lightweight Python mock service for OpenMetadata, ServiceNow, Jira, and dbt (< 20MB RAM)
# ==============================================================================

FROM python:3.12-alpine@sha256:1b668429b3511ab407d8e00648891631b0b1a4d7e15e3ca70f38ab5b91ad4ab4

WORKDIR /app

COPY containers/mock-extensions/mock_server.py .
COPY containers/mock-extensions/sample_dbt_manifest.json .

RUN addgroup -g 10001 appgroup && adduser -u 10001 -G appgroup -s /bin/sh -D appuser && \
    chown -R appuser:appgroup /app

EXPOSE 8585

USER 10001:10001

HEALTHCHECK --interval=2s --timeout=2s --start-period=1s --retries=15 \
    CMD wget -q -O- http://127.0.0.1:8585/health || exit 1

ENTRYPOINT ["python3", "mock_server.py"]
