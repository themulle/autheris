# ==============================================================================
# Containerfile for Autheris.Api (BENCHMARK-ONLY image: do not deploy to production)
# Multi-stage build for production-ready, rootless container execution
# ==============================================================================

# --- Stage 1: Build & Publish ---
FROM mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b AS build
WORKDIR /

# Copy project files first for optimal docker layer caching
COPY src_build/Autheris.sln src_build/Directory.Build.props /gql/
COPY src_build/src/Autheris.Domain/Autheris.Domain.csproj src_build/src/Autheris.Domain/packages.lock.json /gql/src/Autheris.Domain/
COPY src_build/src/Autheris.Application/Autheris.Application.csproj src_build/src/Autheris.Application/packages.lock.json /gql/src/Autheris.Application/
COPY src_build/src/Autheris.GraphQL/Autheris.GraphQL.csproj src_build/src/Autheris.GraphQL/packages.lock.json /gql/src/Autheris.GraphQL/
COPY src_build/src/Autheris.Infrastructure/Autheris.Infrastructure.csproj src_build/src/Autheris.Infrastructure/packages.lock.json /gql/src/Autheris.Infrastructure/
COPY src_build/src/Autheris.Api/Autheris.Api.csproj src_build/src/Autheris.Api/packages.lock.json /gql/src/Autheris.Api/
COPY src_build/NuGet.config /gql/

COPY src_build/gql_extensions/Directory.Build.props /gql_extensions/
COPY src_build/gql_extensions/src/Autheris.Extensions/Autheris.Extensions.csproj /gql_extensions/src/Autheris.Extensions/

WORKDIR /gql
RUN dotnet restore src/Autheris.Api/Autheris.Api.csproj --locked-mode

# Copy remaining source code
COPY src_build/src/ /gql/src/
COPY src_build/gql_extensions/src/ /gql_extensions/src/

# Build and publish
WORKDIR /gql/src/Autheris.Api
RUN dotnet publish -c Release -o /app/publish --no-restore -p:AutherisIncludeTestAuth=false

# --- Stage 2: Runtime Image ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0.13@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac AS runtime
WORKDIR /app

# Install curl for robust container health checks
USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root user for rootless Podman execution (UID 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/bash appuser

# Create data directory for SQLite governance DB
RUN mkdir -p /app/data && chown -R appuser:appgroup /app/data /app

# Copy published application
COPY --from=build --chown=appuser:appgroup /app/publish .
# SC-06: Copy only appsettings.Benchmark.json without overwriting Production/Development files
COPY --chown=appuser:appgroup containers/gqlgateway-api/appsettings.Benchmark.json ./appsettings.Benchmark.json

USER 10001:10001

ENV ASPNETCORE_URLS=http://+:5050 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true
# SECURITY: no secrets are baked into the image. HMAC_SECRET_KEY, the ForwardAuth shared secret etc.
# are injected at runtime by podman-compose.yaml from the untracked .env file.

EXPOSE 5050

HEALTHCHECK --interval=3s --timeout=3s --start-period=5s --retries=10 \
    CMD curl -fsS http://127.0.0.1:5050/health/live || exit 1

ENTRYPOINT ["dotnet", "Autheris.Api.dll"]
