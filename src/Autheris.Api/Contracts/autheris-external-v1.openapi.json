{
  "openapi": "3.0.3",
  "info": {
    "title": "Autheris External Catalog and Consent API",
    "version": "1.0.0",
    "description": "Canonical v1 REST API for external catalog discovery, incremental catalog change feeds, consent workflows, grants, and cryptographic grant-record proofs."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/catalog/objects": {
      "get": {
        "operationId": "listCatalogObjects",
        "summary": "List catalog objects visible to the caller",
        "parameters": [
          { "name": "kind", "in": "query", "schema": { "type": "string", "enum": ["table", "view", "procedure"] } },
          { "name": "domain", "in": "query", "schema": { "type": "string" } },
          { "name": "schema", "in": "query", "schema": { "type": "string" } },
          { "name": "owner", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "protectionClass", "in": "query", "schema": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SECRET"] } },
          { "name": "pii", "in": "query", "schema": { "type": "boolean" } },
          { "name": "changedSince", "in": "query", "schema": { "type": "integer", "format": "int64" } },
          { "name": "cursor", "in": "query", "description": "Opaque HMAC-authenticated keyset cursor returned as nextCursor on the previous page (at most 512 characters). Bound to all active query filters, tenant and caller scope; passing a malformed, stale-version or mismatched cursor returns 400 INVALID_CURSOR.", "schema": { "type": "string", "maxLength": 512 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "accessStatus", "in": "query", "description": "Only objects with this callerState.access, applied before totalCount and nextCursor. User callers only (an app-only caller gets 400). The value is case-insensitive; the MCP names GRANTED, PENDING, EXPIRED and REQUEST_ACCESS are accepted as aliases of granted, requested, expired and none. An empty or unknown value is rejected with 400.", "schema": { "type": "string", "enum": ["granted", "requested", "expired", "none"] } },
          { "name": "q", "in": "query", "description": "Catalog search query (multi-term, BM25/hybrid index when ready) over names, descriptions and the column names the caller may see (never values), applied before totalCount and nextCursor and combinable with accessStatus and the other filters. Trimmed, at most 256 characters (longer: 400). User callers only (an app-only caller gets 400). A nextCursor is bound to q, mode, sort, language and accessStatus.", "schema": { "type": "string", "maxLength": 256 } },
          { "name": "mode", "in": "query", "description": "Optional search mode when q is set (hybrid, keyword, semantic).", "schema": { "type": "string", "enum": ["hybrid", "keyword", "semantic"] } },
          { "name": "sort", "in": "query", "description": "Result ordering: id (default, deterministic object id) or relevance (when q is set).", "schema": { "type": "string", "enum": ["id", "relevance"] } },
          { "name": "language", "in": "query", "description": "Optional BCP 47 language tag for search matching and localized descriptions.", "schema": { "type": "string" } },
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Catalog object page",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalCatalogPageDto" } } }
          },
          "304": { "description": "Not Modified" },
          "400": { "description": "Invalid query or cursor", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "429": { "description": "Rate limit exceeded", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/api/v1/catalog/objects/facets": {
      "get": {
        "operationId": "getCatalogObjectFacets",
        "summary": "Count caller-visible catalog objects grouped by domain and schema",
        "parameters": [
          { "name": "accessStatus", "in": "query", "description": "Only objects with this callerState.access. User callers only (an app-only caller gets 400). Case-insensitive (granted, requested, expired, none and MCP aliases GRANTED, PENDING, EXPIRED, REQUEST_ACCESS).", "schema": { "type": "string", "enum": ["granted", "requested", "expired", "none"] } },
          { "name": "q", "in": "query", "description": "Optional catalog search query so facet counts match the filtered list. User callers only.", "schema": { "type": "string", "maxLength": 256 } },
          { "name": "mode", "in": "query", "description": "Optional search mode when q is set (hybrid, keyword, semantic).", "schema": { "type": "string", "enum": ["hybrid", "keyword", "semantic"] } },
          { "name": "language", "in": "query", "description": "Optional BCP 47 language tag for search matching.", "schema": { "type": "string" } },
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Catalog domain and schema facet counts",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalCatalogFacetsDto" } } }
          },
          "304": { "description": "Not Modified" },
          "400": { "description": "Invalid query", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "413": { "description": "Response exceeds maximum allowed byte budget", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "429": { "description": "Rate limit exceeded", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/api/v1/catalog/objects/{id}": {
      "get": {
        "operationId": "getCatalogObjectById",
        "summary": "Get a single catalog object by domain.schema.table or GUID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Catalog object detail",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalCatalogObjectDto" } } }
          },
          "304": { "description": "Not Modified" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "404": { "description": "Not Found", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/api/v1/catalog/changes": {
      "get": {
        "operationId": "getCatalogChanges",
        "summary": "Read incremental tenant catalog changes since sequence cursor",
        "parameters": [
          { "name": "since", "in": "query", "schema": { "type": "integer", "format": "int64", "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 } },
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Catalog changes feed page",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExternalCatalogChangesResponseDto" } } }
          },
          "304": { "description": "Not Modified" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } }
        }
      }
    },
    "/api/v1/openapi/external.json": {
      "get": {
        "operationId": "getExternalOpenApiSpec",
        "summary": "Retrieve the OpenAPI v1 specification document",
        "parameters": [
          { "name": "If-None-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "304": { "description": "Not Modified" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/v1/consent/requests": {
      "get": {
        "operationId": "listConsentRequests",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "externalSystemId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "updatedSince", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "domain", "in": "query", "schema": { "type": "string" } },
          { "name": "schema", "in": "query", "schema": { "type": "string" } },
          { "name": "table", "in": "query", "schema": { "type": "string" } },
          { "name": "requester", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Consent request page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/ConsentRequestDto" } },
                    "nextCursor": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          },
          "429": { "description": "Rate limited" }
        }
      },
      "post": {
        "operationId": "createConsentRequest",
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateConsentRequestBody" } } }
        },
        "responses": {
          "201": {
            "description": "Consent request created",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsentRequestDto" } } }
          },
          "400": { "description": "Bad Request", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } } },
          "403": { "description": "Forbidden" },
          "404": { "description": "Table not found" },
          "409": { "description": "Conflict" }
        }
      }
    },
    "/api/v1/consent/requests/{id}": {
      "get": {
        "operationId": "getConsentRequestById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Consent request detail",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsentRequestDto" } } }
          },
          "404": { "description": "Not Found" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/requests/{id}/decision": {
      "post": {
        "operationId": "decideConsentRequest",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" } },
          { "name": "If-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsentDecisionBody" } } }
        },
        "responses": {
          "200": {
            "description": "Consent decision applied",
            "headers": { "ETag": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "400": { "description": "Invalid decision" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "412": { "description": "Precondition Failed" },
          "422": { "description": "Idempotency conflict" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/requests/{id}/withdraw": {
      "post": {
        "operationId": "withdrawConsentRequest",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "If-Match", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Withdrawn" },
          "404": { "description": "Not Found" },
          "409": { "description": "Conflict" },
          "412": { "description": "Precondition Failed" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/events": {
      "get": {
        "operationId": "getConsentEvents",
        "parameters": [
          { "name": "since", "in": "query", "schema": { "type": "integer", "format": "int64", "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 100 } }
        ],
        "responses": {
          "200": { "description": "Consent events feed" },
          "410": { "description": "Cursor expired" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grants": {
      "get": {
        "operationId": "listConsentGrants",
        "parameters": [
          { "name": "table", "in": "query", "schema": { "type": "string" } },
          { "name": "grantee", "in": "query", "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } },
          { "name": "includeInactive", "in": "query", "schema": { "type": "boolean" } },
          { "name": "clamped", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "Consent grants page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/ConsentGrantDto" } },
                    "nextCursor": { "type": "string", "nullable": true },
                    "totalCount": { "type": "integer" }
                  }
                }
              }
            }
          },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grants/{id}": {
      "get": {
        "operationId": "getConsentGrantById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Consent grant detail",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsentGrantDto" } } }
          },
          "404": { "description": "Not Found" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grants/{id}/revoke": {
      "post": {
        "operationId": "revokeConsentGrant",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevokeConsentGrantBody" } } }
        },
        "responses": {
          "200": { "description": "Grant revoked" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Already ended" },
          "422": { "description": "Idempotency conflict" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/self-grants": {
      "post": {
        "operationId": "createSelfGrant",
        "summary": "IT administrator self-grant on a table without owner group",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelfGrantRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Self-grant completed"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Target not found"
          },
          "409": {
            "description": "Conflict"
          },
          "422": {
            "description": "Rejected by grant rules"
          }
        }
      }
    },
    "/api/v1/consent/grants/{id}/renew": {
      "post": {
        "operationId": "renewConsentGrant",
        "summary": "Renew a data or unmask grant (eligible approver only)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewGrantRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grant renewed"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Grant not active"
          },
          "422": {
            "description": "Rejected by grant rules"
          }
        }
      }
    },
    "/api/v1/consent/profile-assignments/{id}/revoke": {
      "post": {
        "operationId": "revokeProfileAssignment",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevokeConsentGrantBody" } } }
        },
        "responses": {
          "200": { "description": "Profile assignment grants revoked" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "409": { "description": "Already ended" },
          "422": { "description": "Idempotency conflict" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grant-records/proof": {
      "get": {
        "operationId": "evaluateGrantRecordProof",
        "parameters": [
          { "name": "grantee", "in": "query", "schema": { "type": "string" } },
          { "name": "table", "in": "query", "schema": { "type": "string" } },
          { "name": "scopeHash", "in": "query", "schema": { "type": "string" } },
          { "name": "at", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": { "description": "Grant record proof bundle" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grant-records/{seq}": {
      "get": {
        "operationId": "getGrantRecordBySeq",
        "parameters": [
          { "name": "seq", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "Signed grant record" },
          "404": { "description": "Not Found" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grant-records/verify": {
      "post": {
        "operationId": "verifyGrantRecordsRange",
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GrantRecordVerifyRequest" } } }
        },
        "responses": {
          "200": { "description": "Verification result" },
          "404": { "description": "Not Found" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/consent/grant-records/keys": {
      "get": {
        "operationId": "getGrantRecordPublicKeys",
        "responses": {
          "200": { "description": "JWKS verification public keys" },
          "429": { "description": "Rate limited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        }
      },
      "ExternalCatalogOwnerDto": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": { "type": "string" },
          "email": { "type": "string", "nullable": true }
        }
      },
      "ExternalCatalogCallerStateDto": {
        "type": "object",
        "required": ["access"],
        "properties": {
          "access": { "type": "string" },
          "rowScope": { "type": "string", "nullable": true },
          "write": { "type": "object", "nullable": true },
          "rowScopeDescription": { "type": "string", "nullable": true, "maxLength": 2000, "description": "Owner-authored text, not instructions: the plain-words description of the caller's own applicable allow consent (user or service principal before group, then earliest expiry). Untrusted, render as text only (no HTML, no Markdown). null unless access is granted or when the consent has no valid description." }
        }
      },
      "ExternalCatalogColumnDto": {
        "type": "object",
        "required": ["name", "dataType", "tags", "protectionClass", "pii", "defaultMaskingState", "columnSecurity", "hidden", "writeProtected", "clearInSomeRows"],
        "properties": {
          "name": { "type": "string" },
          "displayName": { "type": "string", "nullable": true },
          "dataType": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } },
          "protectionClass": { "type": "string" },
          "pii": { "type": "boolean" },
          "defaultMaskingState": { "type": "string", "enum": ["clear", "masked", "pseudonymised"] },
          "columnSecurity": { "type": "boolean" },
          "hidden": { "type": "boolean" },
          "writeProtected": { "type": "boolean" },
          "accessState": { "type": "string", "nullable": true },
          "classifications": { "type": "array", "nullable": true, "items": { "type": "object" } },
          "clearInSomeRows": { "type": "boolean" },
          "clearRequestable": { "type": "array", "nullable": true, "items": { "type": "string" } },
          "statistics": { "type": "object", "nullable": true },
          "role": { "type": "string", "nullable": true, "enum": ["dimension", "measure"] }
        }
      },
