<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Autheris.GraphQL\Autheris.GraphQL.csproj" />
    <ProjectReference Include="..\Autheris.Infrastructure\Autheris.Infrastructure.csproj" />
    <ProjectReference Include="..\Autheris.Application\Autheris.Application.csproj" />
    <ProjectReference Include="..\Autheris.Domain\Autheris.Domain.csproj" />
    <ProjectReference Include="..\Autheris.Extensions\Autheris.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Benchmark & High-Throughput Performance Tuning (F-PERF / graphql-bench) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GCDynamicAdaptationMode>1</GCDynamicAdaptationMode>
    <TieredPGO>true</TieredPGO>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <!-- #509: ReadyToRun removed (spike NO-GO, benchmarks/results/r2r-spike-report.md). RuntimeIdentifiers keeps the linux-x64 graph in the locked restore used by the framework-dependent publish. -->
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(_IsPublishing)' == 'true' And '$(RuntimeIdentifier)' == '' And '$(SelfContained)' != 'true'">linux-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(RuntimeIdentifier)' == 'linux-x64' And '$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger UI wird lokal ausgeliefert (offline-faehig, kein CDN) -->
    <EmbeddedResource Include="Assets\swagger-ui\*.css;Assets\swagger-ui\*.js;Assets\swagger-ui\*.png" LogicalName="swagger-ui/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Autheris.Tests.Unit" />
    <InternalsVisibleTo Include="Autheris.Tests.Integration" />
  </ItemGroup>

</Project>
