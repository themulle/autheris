<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Autheris.Application\Autheris.Application.csproj" />
    <ProjectReference Include="..\Autheris.Domain\Autheris.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Garnet" Version="2.2.5" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageReference Include="OpenTelemetry" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.29" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\Shape\governance-shape.*.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Persistence\Migrations\Steps\**\*.sql;Persistence\Migrations\Steps\**\*.shape.json" LogicalName="governance-step.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Autheris.Tests.Unit" />
    <InternalsVisibleTo Include="Autheris.Tests.Integration" />
  </ItemGroup>

</Project>
