# ==============================================================================
# Autheris - Production Container Image
# Multi-protocol Enterprise GraphQL Gateway (Hardened Production Posture)
# ==============================================================================

FROM mcr.microsoft.com/dotnet/aspnet:10.0.14@sha256:de0ee358cdd672f7017a003bed21e9ac9ed48a27c922a59b18175b6e82fa7fee AS runtime
WORKDIR /app

# Production environment variables
ENV ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0 \
    DOTNET_System_Net_Security_UseManagedNtlm=true \
    Gateway__Caching__Garnet__EnableEmbeddedServer=true \
    Gateway__Caching__Garnet__Host=127.0.0.1 \
    Gateway__Caching__Garnet__Port=3278 \
    Gateway__State__StateDirectory=/app/data \
    Gateway__GovernanceDb__ConnectionString="Data Source=/app/data/governance.db"

EXPOSE 8080

# Setup data volume for SQLite governance DB and install GSSAPI/NTLM/Kerberos runtime with non-root ownership (10001:10001)
RUN mkdir -p /app/data && chown -R 10001:10001 /app/data
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgssapi-krb5-2 \
        gss-ntlmssp \
        krb5-user \
        libkrb5-3 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/gss/mech.d \
    && if [ -f /etc/gss/mech.d/mech.ntlmssp.conf ]; then \
        chmod 0644 /etc/gss/mech.d/mech.ntlmssp.conf \
        && cp -f /etc/gss/mech.d/mech.ntlmssp.conf /etc/gss/mech \
        && chmod 0644 /etc/gss/mech; \
    fi \
    && mkdir -p /app/data/gss \
    && chown -R 10001:10001 /app/data/gss \
    && chmod 0700 /app/data/gss
VOLUME /app/data

# Copy pre-built publish artifacts
COPY dist/publish/ ./

# Non-Root User Drop (UID:GID 10001:10001)
USER 10001:10001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD dotnet Autheris.Api.dll --healthcheck || exit 1

ENTRYPOINT ["dotnet", "Autheris.Api.dll"]
