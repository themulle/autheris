# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit LF for shell scripts and SQL files
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf

# Governance migration steps and goldens are hashed: byte-stable LF (issue #388, I388-SC-01)
src/Autheris.Infrastructure/Persistence/Migrations/Steps/** text eol=lf
tests/Autheris.Tests.Architecture/Golden/** text eol=lf
